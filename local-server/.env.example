# Copy this file to .env on the development computer.
# Replace every REPLACE_WITH_ value with a unique locally generated value.
# Never commit .env or send its contents in chat.

CORNHILL_DB_HOST=127.0.0.1
CORNHILL_DB_PORT=54329
CORNHILL_DB_NAME=cornhill_local
CORNHILL_DB_ADMIN_USER=cornhill_local_admin
CORNHILL_DB_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# This dedicated role is deliberately NOLOGIN until all gates pass.
CORNHILL_DB_RUNTIME_USER=cornhill_auth_api
CORNHILL_DB_RUNTIME_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_RUNTIME_PASSWORD

# Keep this secret stable across restarts; generate at least 32 random bytes.
CORNHILL_AUTH_FINGERPRINT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# DNS name and port must match the local HTTPS certificate SAN and listener.
# Add cornhill.local to the Windows hosts file as 127.0.0.1 only for local testing.
CORNHILL_LOCAL_ORIGIN=https://cornhill.local:4174
CORNHILL_LOCAL_HOST=127.0.0.1
CORNHILL_LOCAL_PORT=4174

# Store private key and certificate outside the Git repository.
CORNHILL_TLS_KEY_PATH=REPLACE_WITH_ABSOLUTE_PRIVATE_KEY_PATH
CORNHILL_TLS_CERT_PATH=REPLACE_WITH_ABSOLUTE_CERTIFICATE_PATH
