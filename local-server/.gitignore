# Local environment secrets
.env
.env.*
!.env.example

# Local PostgreSQL exports and backups
*.sql
# Keep only the non-executable, review-only source access proposals visible.
!scripts/provision-source-inventory-readonly-role.review.sql
!scripts/verify-source-inventory-readonly-role.review.sql
*.dump
*.backup
backups/

# Runtime logs and temporary files
*.log
.tmp/

# TLS key material and private certificate bundles
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer

# Generated local npm lockfiles are not part of this lockfile-free desktop install.
package-lock.json

# Temporary local diagnostic scratch file; never commit machine-specific checks.
scripts/check-director-account.mjs
