{
  "id": "/apps/school-website/",
  "name": "CORNHILL Nursery and Primary School",
  "short_name": "CORNHILL Website",
  "description": "Public school information and admission enquiry website",
  "start_url": "/apps/school-website/",
  "scope": "/apps/school-website/",
  "display": "fullscreen",
  "background_color": "#f5f8f4",
  "theme_color": "#14532d",
  "icons": [
    {
      "src": "/assets/cornhill-school-pwa-192.svg",
      "sizes": "192x192",
